# This is an example configuration file.
# Copy this file to a new file named .env and fill in your actual credentials.

# --- Credentials for the LangChain AutoPlanner Generator ---
# The API endpoint and key needed to run the generator tool itself.
API_BASE_URL="http://your_api_base_url_here/v1"
API_KEY="sk-your_generator_api_key_here"

# --- Credentials for the Generated LangChain Project ---
# The API key needed by the project that this tool generates.
# The generated code will look for this variable.
OPENAI_API_KEY="sk-your_project_api_key_here"
